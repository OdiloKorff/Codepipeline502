[bandit]
# Bandit configuration for Low-Noise profile
# Focus only on codepipeline main package

# Tests to skip (reduce noise)
skips = B101,B601,B602,B603,B604,B605,B606,B607,B608,B609,B610,B611

# Tests to exclude (development/testing related)
exclude_dirs = tests,test_*,.venv,venv,build,dist,.git,__pycache__,orchestration_work,overnight_test_run

# Only scan main package
include = codepipeline

# Exclude specific files that are known safe
exclude = */test_*,test_*.py,*_test.py,conftest.py

# Confidence levels to report (HIGH, MEDIUM, LOW)
# For production: only HIGH and MEDIUM
# For LOW-NOISE: only HIGH
confidence = HIGH

# Severity levels to report
# For LOW-NOISE: only HIGH severity
severity = HIGH

# Output format
format = json

# Exclude specific test patterns that generate false positives
[bandit.assert_used]
# Allow assert in tests
skips = ["**/test_*.py", "**/tests/*.py"]

[bandit.hardcoded_password_string]
# Allow hardcoded passwords in test files
word_list = ["password", "pass", "passwd", "pwd", "secret", "token"]

[bandit.hardcoded_password_funcarg]
# Allow hardcoded password function arguments in tests
word_list = ["password", "pass", "passwd", "pwd", "secret", "token"]

[bandit.hardcoded_password_default]
# Allow hardcoded password defaults in tests  
word_list = ["password", "pass", "passwd", "pwd", "secret", "token"]

[bandit.subprocess_popen_with_shell_equals_true]
# Allow shell=True in specific controlled cases with # nosec
