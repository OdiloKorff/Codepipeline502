[run]
# Source packages to measure coverage for
source = codepipeline

# Files/directories to omit from coverage
omit = 
    tests/*
    test_*
    */tests/*
    */test_*
    .venv/*
    venv/*
    build/*
    dist/*
    .git/*
    __pycache__/*
    */migrations/*
    */venv/*
    */.venv/*
    */build/*
    */dist/*
    setup.py
    conftest.py

# Include patterns (focus on main package)
include = 
    codepipeline/*
    codepipeline/**/*

[report]
# Reporting configuration
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

# Show missing lines in terminal output
show_missing = True

# Precision for coverage percentage
precision = 2

[xml]
# XML output configuration for coverage.xml
output = coverage.xml

[html]
# HTML output configuration
directory = htmlcov
title = Codepipeline Coverage Report